    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "sst": "^4.17.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-rds-data": "^3.1176.0",
    "@aws-sdk/client-sns": "^3.1176.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.21",
    "zod": "^4.6.7"
  }
